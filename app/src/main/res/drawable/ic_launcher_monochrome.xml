<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon (Material You) monochrome layer.
     The full iOS art has gradient + figure detail that doesn't tint cleanly
     to a single color, so use the silverbp_fg PNG as the source — Android
     will desaturate + tint it to match the user's wallpaper-derived theme. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/silverbp_fg"
    android:gravity="fill"
    android:antialias="true"
    android:tint="#000000" />
