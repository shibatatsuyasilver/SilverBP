<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy Auto Backup rules for API <31. App's minSdk is 33 so this file is
    largely vestigial; the primary rules live in data_extraction_rules.xml.
    Kept in lock-step for OEMs that still honour the legacy path.
-->
<full-backup-content>
    <!-- System cloud backup must not copy health data or privacy-sensitive
         settings. Users can export encrypted backups explicitly from the app. -->
    <exclude domain="database" path="silverbp.db" />
    <exclude domain="database" path="silverbp.db-wal" />
    <exclude domain="database" path="silverbp.db-shm" />
    <exclude domain="database" path="silverbp.db-journal" />
    <exclude domain="file" path="datastore/user_settings.preferences_pb" />
    <exclude domain="file" path="datastore/current_member.preferences_pb" />
    <exclude domain="file" path="datastore/achievements_internal.preferences_pb" />
    <exclude domain="file" path="datastore/weight_sync_internal.preferences_pb" />
    <!-- Keystore-wrapped EncryptedSharedPreferences: DB key, Drive-backup recovery
         code, and sync root keys. Ciphertext is undecryptable off-device, but it is
         still secret/PII so it must never leave via system backup or transfer. -->
    <exclude domain="sharedpref" path="silverbp.dbkey.xml" />
    <exclude domain="sharedpref" path="silverbp.backup.recovery.xml" />
    <exclude domain="sharedpref" path="silverbp.sync.rootkeys.xml" />
    <exclude domain="file" path="photos/" />
    <exclude domain="file" path="models/" />
</full-backup-content>
