<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy Auto Backup rules for API <31. App's minSdk is 33 so this file is
    largely vestigial; the primary rules live in data_extraction_rules.xml.
    Kept in lock-step for OEMs that still honour the legacy path.
-->
<full-backup-content>
    <!-- Room DB. SilverBpBackupAgent further excludes silverbp.db* when the
         user has opted into SQLCipher at-rest encryption (Keystore key dies
         on uninstall, so backed-up ciphertext would be unreadable on restore). -->
    <include domain="database" path="silverbp.db" />
    <include domain="database" path="silverbp.db-wal" />
    <include domain="database" path="silverbp.db-shm" />

    <!-- Jetpack DataStore (user settings). Plain protobuf file; sensitive
         free-text values inside are Keystore-encrypted only when app-lock is
         on, so they too get the agent treatment. -->
    <include domain="file" path="datastore/user_settings.preferences_pb" />

    <!-- LLM model weights (~1-3 GB). User can re-download. -->
    <exclude domain="file" path="models/" />
    <!-- BP photos (out of scope per backup plan). -->
    <exclude domain="file" path="photos/" />
    <!-- Transient SQLite journal. -->
    <exclude domain="database" path="silverbp.db-journal" />
</full-backup-content>
