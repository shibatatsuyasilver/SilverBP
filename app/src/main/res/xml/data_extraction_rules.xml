<?xml version="1.0" encoding="utf-8"?>
<!--
    Primary Auto Backup + device-transfer rules for API 31+.

    SilverBP has its own explicit encrypted Drive export path, so system backup
    and device-transfer channels must not copy health data or privacy-sensitive
    settings. SilverBpBackupAgent is a no-op defense-in-depth layer; these XML
    rules keep the policy explicit if the agent is ever removed.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="silverbp.db" />
        <exclude domain="database" path="silverbp.db-wal" />
        <exclude domain="database" path="silverbp.db-shm" />
        <exclude domain="database" path="silverbp.db-journal" />
        <exclude domain="file" path="datastore/user_settings.preferences_pb" />
        <exclude domain="file" path="datastore/current_member.preferences_pb" />
        <exclude domain="file" path="datastore/achievements_internal.preferences_pb" />
        <exclude domain="file" path="datastore/weight_sync_internal.preferences_pb" />
        <!-- Keystore-wrapped EncryptedSharedPreferences: DB key, Drive-backup
             recovery code, and sync root keys. Secret/PII; never via cloud backup. -->
        <exclude domain="sharedpref" path="silverbp.dbkey.xml" />
        <exclude domain="sharedpref" path="silverbp.backup.recovery.xml" />
        <exclude domain="sharedpref" path="silverbp.sync.rootkeys.xml" />
        <exclude domain="file" path="photos/" />
        <exclude domain="file" path="models/" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="database" path="silverbp.db" />
        <exclude domain="database" path="silverbp.db-wal" />
        <exclude domain="database" path="silverbp.db-shm" />
        <exclude domain="database" path="silverbp.db-journal" />
        <exclude domain="file" path="datastore/user_settings.preferences_pb" />
        <exclude domain="file" path="datastore/current_member.preferences_pb" />
        <exclude domain="file" path="datastore/achievements_internal.preferences_pb" />
        <exclude domain="file" path="datastore/weight_sync_internal.preferences_pb" />
        <!-- Keystore-wrapped EncryptedSharedPreferences: DB key, Drive-backup
             recovery code, and sync root keys. Secret/PII; never via transfer. -->
        <exclude domain="sharedpref" path="silverbp.dbkey.xml" />
        <exclude domain="sharedpref" path="silverbp.backup.recovery.xml" />
        <exclude domain="sharedpref" path="silverbp.sync.rootkeys.xml" />
        <exclude domain="file" path="photos/" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
